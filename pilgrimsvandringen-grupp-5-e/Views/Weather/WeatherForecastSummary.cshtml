@{
}

<h2>Väderprognos den kommande veckan på våra leder</h2>

<div>
    <ul>
        <li>
            <a class="nav-link text-dark" asp-area="" asp-controller="Weather" asp-action="WeatherForeCastDetailsGreen">
                <h3>Jämt-Norgeleden</h3>
                    <div>
                        <h4>Startpunkt: Revsund</h4>
                        <p>@Model[0].hourly.time[12]</p>
                        <p>@Model[0].hourly.temperature_2m[12] @Model[0].hourly_units.temperature_2m</p>
                    </div>
                    <div>
                        <h4>Slutpunkt: Stugudalen</h4>
                        <p>@Model[1].hourly.time[12]</p>
                        <p>@Model[1].hourly.temperature_2m[12] @Model[1].hourly_units.temperature_2m</p>
                    </div>
            </a>
        </li>
        <li>
            <a class="nav-link text-dark" asp-area="" asp-controller="Weather" asp-action="WeatherForeCastDetailsYellow">
                <h3>Kårböleleden</h3>
                <div>
                    <h4>Startpunkt: Kårböle</h4>
                    <p>@Model[2].hourly.time[12]</p>
                    <p>@Model[2].hourly.temperature_2m[12] @Model[2].hourly_units.temperature_2m</p>
                </div>
                <div>
                    <h4>Slutpunkt: Billsåsen</h4>
                    <p>@Model[3].hourly.time[12]</p>
                    <p>@Model[3].hourly.temperature_2m[12] @Model[3].hourly_units.temperature_2m</p>
                </div>
            </a>
        </li>
        <li>
            <a class="nav-link text-dark" asp-area="" asp-controller="Weather" asp-action="WeatherForeCastDetailsRed">
                <h3>S:t Olavsleden</h3>
                <div>
                    <h4>Startpunkt: Sundsvall</h4>
                    <p>@Model[4].hourly.time[12]</p>
                    <p>@Model[4].hourly.temperature_2m[12] @Model[4].hourly_units.temperature_2m</p>
                </div>
                <div>
                    <h4>Slutpunkt: Trondheim</h4>
                    <p>@Model[5].hourly.time[12]</p>
                    <p>@Model[5].hourly.temperature_2m[12] @Model[5].hourly_units.temperature_2m</p>
                </div>
            </a>
        </li>
        <li>
            <a class="nav-link text-dark" asp-area="" asp-controller="Weather" asp-action="WeatherForeCastDetailsBlue">
                <h3>Indalsleden</h3>
                <div>
                    <h4>Startpunkt: Selånger</h4>
                    <p>@Model[6].hourly.time[12]</p>
                    <p>@Model[6].hourly.temperature_2m[12] @Model[6].hourly_units.temperature_2m</p>
                </div>
                <div>
                    <h4>Slutpunkt: lit</h4>
                    <p>@Model[7].hourly.time[12]</p>
                    <p>@Model[7].hourly.temperature_2m[12] @Model[7].hourly_units.temperature_2m</p>
                </div>
            </a>
        </li>
    </ul>
    
    
</div>

