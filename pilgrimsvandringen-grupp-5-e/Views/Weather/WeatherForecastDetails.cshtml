@{
}
@if(Model != null)
{
    <div class="weather-container">
        <h3>Platsförnamn för vald led</h3>
        <div>
            <h4>Start:</h4>
            @for (int i = 0; i < Model[0].Hourly.Time.Count; i++)
            {

                <div>
                    <table>
                        <h4>Datum och klockslag: @Model[0].Hourly.Time[i]</h4>
                        <tr>
                            <th>Temperatur</th>
                            <th>Sannolikhet för nederbörd</th>
                            <th>Nederbörd</th>
                            <th>Snödjup</th>
                            <th>Vindstyrka</th>
                            <th>Vindriktning</th>
                            <th>Kastvindar</th>
                        </tr>
                        <tr>
                            <td>@Model[0].Hourly.Temperature[i] @Model[0].HourlyUnits.Temperature</td>
                            <td>@Model[0].Hourly.PrecipitationProbability[i] @Model[0].HourlyUnits.PrecipitationProbability</td>
                            <td>@Model[0].Hourly.Precipitation[i] @Model[0].HourlyUnits.Precipitation</td>
                            <td>@Model[0].Hourly.SnowDepth[i] @Model[0].HourlyUnits.SnowDepth</td>
                            <td>@Model[0].Hourly.WindSpeed[i] @Model[0].HourlyUnits.WindSpeed</td>
                            <td>@Model[0].Hourly.WindDirection[i] @Model[0].HourlyUnits.WindDirection</td>
                            <td>@Model[0].Hourly.WindGusts[i] @Model[0].HourlyUnits.WindGusts</td>
                        </tr>
                    </table>
                </div>
            }
        </div>
        <div>
            <h4>Slut:</h4>
            @for (int i = 0; i < Model[1].Hourly.Time.Count; i++)
            {

                <div>

                    <table>
                        <h4>Datum och klockslag: @Model[1].Hourly.Time[i]</h4>
                        <tr>
                            <th>Temperatur</th>
                            <th>Sannolikhet för nederbörd</th>
                            <th>Nederbörd</th>
                            <th>Snödjup</th>
                            <th>Vindstyrka</th>
                            <th>Vindriktning</th>
                            <th>Kastvindar</th>
                        </tr>
                        <tr>
                            <td>@Model[1].Hourly.Temperature[i] @Model[1].HourlyUnits.Temperature</td>
                            <td>@Model[1].Hourly.PrecipitationProbability[i] @Model[1].HourlyUnits.PrecipitationProbability</td>
                            <td>@Model[1].Hourly.Precipitation[i] @Model[1].HourlyUnits.Precipitation</td>
                            <td>@Model[1].Hourly.SnowDepth[i] @Model[1].HourlyUnits.SnowDepth</td>
                            <td>@Model[1].Hourly.WindSpeed[i] @Model[1].HourlyUnits.WindSpeed</td>
                            <td>@Model[1].Hourly.WindDirection[i] @Model[1].HourlyUnits.WindDirection</td>
                            <td>@Model[1].Hourly.WindGusts[i] @Model[1].HourlyUnits.WindGusts</td>
                        </tr>
                    </table>
                </div>
            }
        </div>
    </div>
    
   
}
