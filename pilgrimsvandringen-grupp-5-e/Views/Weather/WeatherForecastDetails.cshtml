@{
}
@if(Model != null)
{
    <div class="weather-container">
        <div>
            @for (int i = 0; i < Model[0].hourly.time.Count; i++)
            {

                <div>
                    <table>
                        <h4>Datum och klockslag: @Model[0].hourly.time[i]</h4>
                        <tr>
                            <th>Temperatur</th>
                            <th>Sannolikhet för nederbörd</th>
                            <th>Nederbörd</th>
                            <th>Snödjup</th>
                            <th>Vindstyrka</th>
                            <th>Vindriktning</th>
                            <th>Kastvindar</th>
                        </tr>
                        <tr>
                            <td>@Model[0].hourly.temperature_2m[i] @Model[0].hourly_units.temperature_2m</td>
                            <td>@Model[0].hourly.precipitation_probability[i] @Model[0].hourly_units.precipitation_probability</td>
                            <td>@Model[0].hourly.precipitation[i] @Model[0].hourly_units.precipitation</td>
                            <td>@Model[0].hourly.snow_depth[i] @Model[0].hourly_units.snow_depth</td>
                            <td>@Model[0].hourly.wind_speed_10m[i] @Model[0].hourly_units.wind_speed_10m</td>
                            <td>@Model[0].hourly.wind_direction_10m[i] @Model[0].hourly_units.wind_direction_10m</td>
                            <td>@Model[0].hourly.wind_gusts_10m[i] @Model[0].hourly_units.wind_gusts_10m</td>
                        </tr>
                    </table>
                </div>
            }
        </div>
        <div>
            @for (int i = 0; i < Model[1].hourly.time.Count; i++)
            {

                <div>
                    <table>
                        <h4>Datum och klockslag: @Model[1].hourly.time[i]</h4>
                        <tr>
                            <th>Temperatur</th>
                            <th>Sannolikhet för nederbörd</th>
                            <th>Nederbörd</th>
                            <th>Snödjup</th>
                            <th>Vindstyrka</th>
                            <th>Vindriktning</th>
                            <th>Kastvindar</th>
                        </tr>
                        <tr>
                            <td>@Model[1].hourly.temperature_2m[i] @Model[1].hourly_units.temperature_2m</td>
                            <td>@Model[1].hourly.precipitation_probability[i] @Model[1].hourly_units.precipitation_probability</td>
                            <td>@Model[1].hourly.precipitation[i] @Model[1].hourly_units.precipitation</td>
                            <td>@Model[1].hourly.snow_depth[i] @Model[1].hourly_units.snow_depth</td>
                            <td>@Model[1].hourly.wind_speed_10m[i] @Model[1].hourly_units.wind_speed_10m</td>
                            <td>@Model[1].hourly.wind_direction_10m[i] @Model[1].hourly_units.wind_direction_10m</td>
                            <td>@Model[1].hourly.wind_gusts_10m[i] @Model[1].hourly_units.wind_gusts_10m</td>
                        </tr>
                    </table>
                </div>
            }
        </div>
    </div>
    
   
}
