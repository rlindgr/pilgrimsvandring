@{
}
@if (Model != null && Model.Count > 0)
{
    foreach (var message in Model)
    {
        <article>
            <h3>@message.Title</h3>
            <p>@message.Description</p>
            <br></br>
            <p>@message.User.UserName</p>
            <p>@message.DateTime</p>
        </article>
    }

}
